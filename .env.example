# Non-secret Compose and host-path settings only. Copy to .env for local use.
THREAT_HUNTING_IMAGE=threat-hunting:dev
THREAT_HUNTING_FRONTEND_IMAGE=threat-hunting-frontend:dev
THREAT_HUNTING_FRONTEND_PORT=8080
THREAT_HUNTING_FRONTEND_BIND=127.0.0.1
# Set false only for a development HTTP LAN workspace. Production requires HTTPS.
THREAT_HUNTING_COOKIE_SECURE=true
# Compose resolves bind mounts and secret files from deploy/docker, where the
# Compose file lives, even when this env file is passed from the repository root.
THREAT_HUNTING_CONFIG_FILE=./config/runtime.yml

# Secret values must be placed in local files that are excluded from Git.
# Compose mounts these files under /run/secrets.
THREAT_HUNTING_DATABASE_URL_FILE=../../runtime/secrets/database_url
THREAT_HUNTING_POSTGRES_PASSWORD_FILE=../../runtime/secrets/postgres_password
THREAT_HUNTING_SPLUNK_TOKEN_FILE=../../runtime/secrets/splunk_token
THREAT_HUNTING_MODEL_API_KEY_FILE=../../runtime/secrets/model_api_key
