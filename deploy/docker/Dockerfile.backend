# One immutable application image is used by the API, worker, and migration job.
# The API serves the frontend build so UI and API requests share one origin.
FROM node:22-alpine AS frontend-build

WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --no-install-recommends --yes build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini

# Install into a relocatable prefix so the final image contains no build toolchain.
RUN python -m pip install --prefix=/install .

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN apt-get update \
    && apt-get install --no-install-recommends --yes libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 threat-hunting \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app --no-create-home threat-hunting \
    && mkdir -p /app /var/lib/threat-hunting /var/lib/threat-hunting-tmp \
    && chown -R threat-hunting:threat-hunting /app /var/lib/threat-hunting /var/lib/threat-hunting-tmp

WORKDIR /app
COPY --from=builder /install /usr/local
COPY --from=builder /build/migrations ./migrations
COPY --from=builder /build/alembic.ini ./alembic.ini
COPY --from=frontend-build /frontend/dist ./frontend/dist

USER threat-hunting:threat-hunting
EXPOSE 8000

# Readiness includes database/migration checks; liveness is exposed separately by the API.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=6 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3).read()"

CMD ["python", "-m", "uvicorn", "threat_hunting.main:app", "--host", "0.0.0.0", "--port", "8000"]
